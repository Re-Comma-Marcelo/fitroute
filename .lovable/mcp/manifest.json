{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://goltxxpjfazehknblwak.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "iron-logger",
      "version": "0.3.0",
      "title": "Route"
    },
    "tools": [
      {
        "name": "get_training_context",
        "title": "Get Route context",
        "description": "Returns the exercise and meal libraries plus, when the user is connected, their profile, recent workouts, recent coach notes and current training folder (standard routines, variations and the swaps they keep making). Call this first — routines and diets may only use ids from here.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_exercise_context",
        "title": "Get exercise context",
        "description": "Read-only detail for one exercise: its muscle group, equipment, written instructions and, when the user is connected, their recent logged sets and heaviest set for it. Use it to answer form and progression questions about a specific movement.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "exerciseId": {
              "type": "string",
              "minLength": 1,
              "description": "Exercise id from get_training_context, e.g. 'ex-supino-reto'."
            }
          },
          "required": [
            "exerciseId"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_routine",
        "title": "Create a workout routine",
        "description": "Creates or updates a workout routine directly in the connected user's app (upsert by name), and also returns an import code as a fallback. New routines land in the user's current training folder. Use role 'variation' (with variationOf and reason) for a lighter/shorter/social version of a standard routine; variations are kept in the folder but never scheduled or recommended on their own. Call get_training_context first for valid exerciseId values and the folder's routines.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "description": "Routine name, e.g. 'Upper A'."
            },
            "description": {
              "default": "",
              "description": "One line on the intent of the routine.",
              "type": "string",
              "maxLength": 200
            },
            "exercises": {
              "minItems": 1,
              "maxItems": 15,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exerciseId": {
                    "type": "string",
                    "minLength": 1,
                    "description": "id from get_training_context."
                  },
                  "sets": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "repsMin": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "repsMax": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "restSec": {
                    "type": "integer",
                    "minimum": 15,
                    "maximum": 600
                  },
                  "notes": {
                    "default": "",
                    "type": "string",
                    "maxLength": 200
                  }
                },
                "required": [
                  "exerciseId",
                  "sets",
                  "repsMin",
                  "repsMax",
                  "restSec"
                ]
              },
              "description": "Exercises in the order they should be performed."
            },
            "role": {
              "description": "'standard' (default for new routines) is part of the plan; 'variation' is an alternative kept for days when life gets in the way. Omit when updating to keep the routine's current role.",
              "type": "string",
              "enum": [
                "standard",
                "variation"
              ]
            },
            "variationOf": {
              "description": "Variation only: name or id of the standard routine it varies.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "reason": {
              "description": "Variation only: busy (short on time), social (training with friends), pain, equipment (taken), difficulty or preference.",
              "type": "string",
              "enum": [
                "busy",
                "social",
                "pain",
                "equipment",
                "difficulty",
                "preference"
              ]
            }
          },
          "required": [
            "name",
            "exercises"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_week_diet",
        "title": "Plan a week of meals",
        "description": "Writes meal slots for one or more days directly into the connected user's app, and also returns an import code as a fallback. Call get_training_context first for valid mealId values.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "minItems": 1,
              "maxItems": 14,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "description": "ISO date, yyyy-mm-dd."
                  },
                  "breakfast": {
                    "description": "mealId",
                    "type": "string"
                  },
                  "lunch": {
                    "description": "mealId",
                    "type": "string"
                  },
                  "snack": {
                    "description": "mealId",
                    "type": "string"
                  },
                  "dinner": {
                    "description": "mealId",
                    "type": "string"
                  }
                },
                "required": [
                  "date"
                ]
              },
              "description": "One entry per day. Leave a slot out if the user does not eat it."
            }
          },
          "required": [
            "days"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "log_coach_note",
        "title": "Log a coach note",
        "description": "Records something the user reported (soreness, an injury, how the week went) directly in the connected user's app, so the in-app coach references it when planning sessions. Also returns an import code as a fallback.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500,
              "description": "Plain language, first person, e.g. 'Left shoulder sore after pressing.'"
            },
            "noteKind": {
              "default": "observation",
              "description": "'checkin' for a weekly review, 'observation' for a one-off.",
              "type": "string",
              "enum": [
                "checkin",
                "observation"
              ]
            },
            "tags": {
              "default": [],
              "description": "Short tags, e.g. ['shoulder', 'soreness'] — used to match exercises.",
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 30
              }
            }
          },
          "required": [
            "content"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
